# Configuración del Servidor
NODE_ENV=
PORT=
HOST=

# Base de datos principal (obligatoria; debe empezar por postgresql://)
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/sistema_rrhh

# Redis para colas (BullMQ). Opcional: aún no se usa
REDIS_URL=redis://localhost:6379

# CORS - Orígenes permitidos (separados por coma)
CORS_ORIGINS=

# Límites de archivos
MAX_FILE_SIZE=
MAX_EMPLOYEES=

# Timeouts y limpieza
FILE_CLEANUP_TIMEOUT=

# Azure AD - Integración con OneDrive
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
BASE_URL=
WEBHOOK_CLIENT_STATE=
ONEDRIVE_USER_EMAIL=

# JWT: cada secreto con al menos 32 caracteres aleatorios y distintos entre sí
JWT_ACCESS_SECRET=CHANGE_ME_min_32_caracteres_aleatorios
JWT_REFRESH_SECRET=CHANGE_ME_otro_secreto_min_32_caracteres
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# Base exclusiva para los e2e (pnpm test:e2e). Debe terminar en _test:
# los tests aplican migraciones, seed y borran filas en ella.
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/kontrak_test
