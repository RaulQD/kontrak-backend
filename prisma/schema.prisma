// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Razones sociales del cliente (multi-RUC, single-tenant). Ver docs/plan_sistema_rrhh_hris.md §5.
model Company {
  id           String    @id @default(uuid()) @db.Uuid
  ruc          String    @unique @db.Char(11)
  legalName    String    @map("legal_name") @db.VarChar(200)
  tradeName    String?   @map("trade_name") @db.VarChar(200)
  address      String?   @db.VarChar(300)
  ubigeoId     String?   @map("ubigeo_id") @db.Char(6) // Código de ubigeo (6 dígitos)
  legalRepName String?   @map("legal_rep_name") @db.VarChar(200)
  legalRepDoc  String?   @map("legal_rep_document") @db.VarChar(15)
  industryCode String?   @map("industry_code") @db.VarChar(10)
  isMicroSmall Boolean   @default(false) @map("is_micro_small")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  ubigeo Ubigeo? @relation(fields: [ubigeoId], references: [id])

  employees Employee[]
  branches  Branch[]
  division  Division[]
  positions Position[]
  contracts Contract[]

  @@map("companies")
}

model Branch {
  id                     String    @id @default(uuid()) @db.Uuid
  companyId              String    @map("company_id") @db.Uuid
  code                   String    @db.VarChar(20)
  name                   String    @db.VarChar(200)
  address                String?   @db.VarChar(300)
  ubigeoId               String?   @map("ubigeo_id") @db.Char(6)
  kind                   String    @default("PLAYA") @db.VarChar(50) //PLAYA | OFICINA
  sunatEstablishmentCode String?   @map("sunat_establishment_code") @db.VarChar(4) // Código de establecimiento SUNAT (4 dígitos)
  isActive               Boolean   @default(true) @map("is_active")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  company   Company    @relation(fields: [companyId], references: [id])
  ubigeo    Ubigeo?    @relation(fields: [ubigeoId], references: [id])
  contracts Contract[]

  @@unique([companyId, code])
  @@map("branches")
}

model Division {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  // parentId          String?   @map("parent_id") @db.Uuid
  code      String    @db.VarChar(20)
  name      String    @db.VarChar(200)
  // managerEmployeeId String?   @map("manager_employee_id") @db.Uuid
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  company   Company    @relation(fields: [companyId], references: [id])
  positions Position[]
  contracts Contract[]

  @@unique([companyId, code])
  @@map("divisions")
}

enum SctrRiskLevel {
  BAJO
  ALTO

  @@map("sctr_risk_level")
}

model Position {
  id                  String        @id @default(uuid()) @db.Uuid
  companyId           String        @map("company_id") @db.Uuid
  code                String        @db.VarChar(20)
  name                String        @db.VarChar(200)
  canonicalName       String?       @map("canonical_name") @db.VarChar(200)
  divisionId          String?       @map("division_id") @db.Uuid
  sctrRiskLevel       SctrRiskLevel @default(BAJO) @map("sctr_risk_level") // BAJO, ALTO
  requiresSctr        Boolean       @default(false) @map("requires_sctr")
  minSalary           Decimal?      @map("min_salary") @db.Decimal(12, 2)
  maxSalary           Decimal?      @map("max_salary") @db.Decimal(12, 2)
  sunatOccupationCode String?       @map("sunat_occupation_code") @db.VarChar(6) // Código de ocupación SUNAT (6 dígitos)
  isActive            Boolean       @default(true) @map("is_active")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?     @map("deleted_at") @db.Timestamptz(6)

  company   Company    @relation(fields: [companyId], references: [id])
  division  Division?  @relation(fields: [divisionId], references: [id])
  contracts Contract[]

  @@unique([companyId, name])
  @@map("positions")
}

model Ubigeo {
  id         String     @id @db.Char(6) // Código de ubigeo (6 dígitos)
  department String     @db.VarChar(80)
  province   String     @db.VarChar(80)
  district   String     @db.VarChar(80)
  companies  Company[]
  branches   Branch[]
  employees  Employee[]

  @@map("ubigeo")
}

/// Tipos de documento de identidad válidos en Perú.
enum DocumentType {
  DNI
  CE // Carné de extranjería
  PASAPORTE
  PTP // Permiso temporal de permanencia

  @@map("document_type")
}

enum EmployeeStatus {
  ACTIVO
  CESADO
  SUSPENDIDO
  VACACIONES
  SUBSIDIADO

  @@map("employee_status")
}

enum SexType {
  MASCULINO
  FEMENINO

  @@map("sex_type")
}

enum MaritalStatus {
  SOLTERO
  CASADO
  DIVORCIADO
  CONVIVIENTE
  VIUDO

  @@map("marital_status")
}

/// Ficha maestra del trabajador. Ver docs/plan_sistema_rrhh_hris.md §5.
model Employee {
  id                   String         @id @default(uuid()) @db.Uuid
  companyId            String         @map("company_id") @db.Uuid
  employeeCode         String?        @map("employee_code") @db.VarChar(20)
  documentType         DocumentType   @default(DNI) @map("document_type")
  documentNumber       String         @map("document_number") @db.VarChar(15)
  firstNames           String         @map("first_names") @db.VarChar(100)
  lastNameFather       String         @map("last_name_father") @db.VarChar(60)
  lastNameMother       String         @map("last_name_mother") @db.VarChar(60)
  fullName             String?        @default(dbgenerated()) @map("full_name") @db.VarChar(220)
  sex                  SexType?       @map("sex")
  birthDate            DateTime?      @map("birth_date") @db.Date
  maritalStatus        MaritalStatus? @map("marital_status")
  nationality          String?        @default("PERUANA") @map("nationality") @db.VarChar(40) // Nacionalidad del trabajador (por defecto: PERUANA)
  email                String?        @db.VarChar(150)
  personalEmail        String?        @map("personal_email") @db.VarChar(150)
  phone                String?        @db.VarChar(20)
  address              String?        @db.VarChar(300)
  ubigeoId             String?        @map("ubigeo_id") @db.Char(6)
  hireDate             DateTime       @map("hire_date") @db.Date
  terminationDate      DateTime?      @map("termination_date") @db.Date
  status               EmployeeStatus @default(ACTIVO)
  hasChildrenUnder18   Boolean        @default(false) @map("has_children_under_18")
  essaludLifeInsurance Boolean        @default(false) @map("essalud_life_insurance")
  photoUrl             String?        @map("photo_url") @db.VarChar(500)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?      @map("deleted_at") @db.Timestamptz(6)

  company   Company    @relation(fields: [companyId], references: [id])
  ubigeo    Ubigeo?    @relation(fields: [ubigeoId], references: [id])
  contracts Contract[]

  @@map("employees")
}

model ContractType {
  id                  String     @id @default(uuid()) @db.Uuid
  code                String     @unique @db.VarChar(30)
  name                String     @db.VarChar(100)
  legalBasis          String?    @map("legal_basis") @db.VarChar(200)
  sunatPlameCode      String?    @map("sunat_plame_code") @db.VarChar(10)
  isFixedTerm         Boolean    @default(true) @map("is_fixed_term")
  maxDurationMonths   Int?       @map("max_duration_months") @db.SmallInt
  requiresReplacement Boolean    @default(false) @map("requires_replacement")
  isPartTime          Boolean    @default(false) @map("is_part_time")
  isActive            Boolean    @default(true) @map("is_active")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  contracts           Contract[]

  @@map("contract_types")
}

enum ContractStatus {
  BORRADOR
  GENERADO
  FIRMADO
  VIGENTE
  VENCIDO
  RESULETO
  RENOVADO

  @@map("contract_status")
}

model Contract {
  id                 String         @id @default(uuid()) @db.Uuid
  employeeId         String         @map("employee_id") @db.Uuid
  companyId          String         @map("company_id") @db.Uuid
  contractTypeId     String         @map("contract_type_id") @db.Uuid
  positionId         String         @map("position_id") @db.Uuid
  branchId           String         @map("branch_id") @db.Uuid
  divisionId         String         @map("division_id") @db.Uuid
  startDate          DateTime       @map("start_date") @db.Date
  endDate            DateTime?      @map("end_date") @db.Date
  salary             Decimal        @db.Decimal(12, 2)
  salaryInWords      String?        @map("salary_in_words") @db.VarChar(250)
  currency           String         @default("PEN") @db.Char(3) // PEN | USD
  weeklyHours        Int            @map("weekly_hours") @db.SmallInt
  workingCondition   String         @map("working_condition") @db.VarChar(100) // Condición de trabajo (por ejemplo: "Tiempo completo", "Medio tiempo", etc.)
  probationMonths    Int?           @map("probation_months") @db.SmallInt
  replacementReason  String?        @map("replacement_reason") @db.VarChar(300)
  status             ContractStatus @default(BORRADOR)
  signedAt           DateTime?      @map("signed_at") @db.Timestamptz(6)
  // parentContractId    String?   @map("parent_contract_id") @db.Uuid
  generationSnapshot Json?          @map("generation_snapshot") @db.JsonB
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz(6)

  employee     Employee     @relation(fields: [employeeId], references: [id])
  company      Company      @relation(fields: [companyId], references: [id])
  contractType ContractType @relation(fields: [contractTypeId], references: [id])
  position     Position     @relation(fields: [positionId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  division     Division     @relation(fields: [divisionId], references: [id])

  @@map("contracts")
}

/// Cuenta de acceso. Sin datos de persona (viven en employees).
/// SQL manual (diseño §3.5): unicidad por índice parcial lower(email) WHERE deleted_at IS NULL.
model User {
  id                  String    @id @default(uuid()) @db.Uuid
  // employeeId       String?   @map("employee_id") @db.Uuid // diferido a la fase que integre Auth con employees (diseño §7.7)
  email               String    @db.VarChar(150) // sin @unique: la unicidad la impone el índice parcial (§3.5)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts") @db.SmallInt
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  lastFailedLoginAt   DateTime? @map("last_failed_login_at") @db.Timestamptz(6)
  lockoutsCount       Int       @default(0) @map("lockouts_count") @db.SmallInt
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]
  userRoles     UserRole[]
  rolesAssigned UserRole[]     @relation("RoleAssignedBy")
  auditLogs     AuditLog[]

  @@map("users")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique @db.VarChar(100)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(80)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "ix_role_permissions_permission")
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy String?  @map("assigned_by") @db.Uuid

  user           User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser User? @relation("RoleAssignedBy", fields: [assignedBy], references: [id])

  @@id([userId, roleId])
  @@index([roleId], map: "ix_user_roles_role")
  @@map("user_roles")
}

/// Rotación con detección de reuso (OWASP). Nunca se guarda el token en claro.
/// SQL manual: índice parcial de sesiones activas (user_id WHERE revoked_at IS NULL).
model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(255)
  tokenFamilyId String    @map("token_family_id") @db.Uuid
  replacedBy    String?   @map("replaced_by") @db.Uuid // token que lo sustituyó al rotar; presencia + reuso = ataque
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  userAgent     String?   @map("user_agent") @db.VarChar(400)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replaces        RefreshToken?  @relation("TokenRotation", fields: [replacedBy], references: [id])
  replacedByToken RefreshToken[] @relation("TokenRotation")

  @@index([tokenFamilyId], map: "ix_refresh_tokens_family")
  @@index([expiresAt], map: "ix_refresh_tokens_expires")
  @@map("refresh_tokens")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String   @db.VarChar(100)
  entityType    String   @map("entity_type") @db.VarChar(100)
  entityId      String?  @map("entity_id") @db.VarChar(64)
  oldValues     Json?    @map("old_values") @db.JsonB
  newValues     Json?    @map("new_values") @db.JsonB
  correlationId String?  @map("correlation_id") @db.Uuid
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt(sort: Desc)], map: "ix_audit_logs_actor")
  @@index([entityType, entityId, createdAt(sort: Desc)], map: "ix_audit_logs_entity")
  @@index([createdAt(sort: Desc)], map: "ix_audit_logs_created")
  @@index([correlationId], map: "ix_audit_logs_correlation")
  @@map("audit_logs")
}

model LegalParameters {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @db.VarChar(40)
  value          Decimal   @db.Decimal(14, 6)
  unit           String    @db.VarChar(20)
  validFrom      DateTime  @map("valid_from") @db.Timestamptz(6)
  validTo        DateTime? @map("valid_to") @db.Timestamptz(6)
  legalReference String    @map("legal_reference") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([code, validFrom(sort: Desc)], map: "ix_legal_parameters_code_vigencia")
  @@map("legal_parameters")
}
